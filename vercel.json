{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/admin-galleries.js": {
      "maxDuration": 60
    },
    "api/gallery-batch-download.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/galeria/:slug",
      "destination": "/api/gallery-page?slug=:slug"
    },
    {
      "source": "/panel/:path*",
      "destination": "/index.html"
    }
  ]
}
