{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/admin-galleries.js": {
      "maxDuration": 60
    },
    "api/gallery-batch-download.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/oferta-warszawianka",
      "destination": "/api/corporate-offer?slug=warszawianka-281026-e14e2a54cd1cf6465b716933"
    },
    {
      "source": "/oferta-firmowa/:slug",
      "destination": "/api/corporate-offer?slug=:slug"
    },
    {
      "source": "/galeria/:slug",
      "destination": "/api/gallery-page?slug=:slug"
    },
    {
      "source": "/panel/:path*",
      "destination": "/index.html"
    }
  ]
}
