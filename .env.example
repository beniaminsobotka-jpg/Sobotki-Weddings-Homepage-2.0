VITE_SITE_URL=https://sobotkiweddings.pl
BREVO_API_KEY=your_brevo_api_key_here
BREVO_LIST_ID_WEDDINGS=4
BREVO_LIST_ID_PORTRAITS_WEDDING=5
BREVO_LIST_ID_PORTRAITS_BOOTH=6
BREVO_NOTIFY_TO_EMAIL=kontakt.sobotki@gmail.com
BREVO_NOTIFY_FROM_EMAIL=kontakt@sobotkiweddings.pl
BREVO_NOTIFY_FROM_NAME=Sobotki Weddings

# Dropbox gallery (prefer refresh-token credentials in production)
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
# Optional fallback for a quick local test; short-lived tokens expire.
# DROPBOX_ACCESS_TOKEN=your_short_lived_access_token
DROPBOX_GALLERY_ROOT=/Galerie
GALLERY_ADMIN_PASSWORD=choose_a_long_random_password
# Optional. If omitted, sessions are signed with DROPBOX_APP_SECRET.
# GALLERY_ADMIN_SESSION_SECRET=another_long_random_secret
